{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true,
    "types": ["node", "jest"],
    "allowJs": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "src/**/*.ts",
    "src/__tests__/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "out",
    "**/*.vsix",
    ".vscode-test"
  ]
}
