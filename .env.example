# ClarityAI Environment Configuration
# Copy this file to .env and fill in your values
# This file should NOT be committed to version control

# Proxy Configuration
# The Cloudflare Worker endpoint for LLM API calls
CLARITY_PROXY_URL=https://clarityai-proxy.attafiahmed-dev.workers.dev

# Proxy Authentication Token
# Used to authenticate requests to the proxy endpoint
# Keep this secure - do not share or commit
CLARITY_PROXY_TOKEN=your-secure-token-here

# Analytics Configuration (Optional)
# PostHog API key for telemetry collection
# Leave empty to disable analytics
CLARITY_ANALYTICS_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sentry Configuration (Optional)
# Sentry DSN for error tracking
# Leave empty to disable error tracking
CLARITY_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Environment Mode
# Set to 'production' for release builds
# Set to 'development' for development builds
NODE_ENV=production

# Logging Configuration (Optional)
# Set to 'true' to enable verbose logging
# Set to 'false' for normal logging
CLARITY_VERBOSE_LOGGING=false
